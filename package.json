{
  "name": "sportshub",
  "version": "0.1.0",
  "private": true,
  "engines": { "node": ">=22.12.0" },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "test": "node --env-file-if-exists=.env node_modules/vitest/vitest.mjs run",
    "db:seed": "tsx prisma/seed.ts",
    "db:push": "prisma db push",
    "db:generate": "prisma generate",
    "db:postgis": "tsx scripts/setup-postgis.ts",
    "venues:near": "tsx scripts/venues-within-radius.ts",
    "test:e2e": "node --env-file-if-exists=.env --import tsx scripts/run-e2e.ts"
  },
  "dependencies": {
    "@aws-sdk/client-bedrock-runtime": "^3.1157.0",
    "@aws-sdk/client-s3": "^3.1156.0",
    "@aws-sdk/s3-request-presigner": "^3.1156.0",
    "@prisma/client": "6.19.3",
    "@upstash/redis": "^1.39.0",
    "bcryptjs": "^3.0.2",
    "jose": "^6.1.0",
    "leaflet": "^1.9.4",
    "lucide-react": "^0.544.0",
    "next": "^15.5.28",
    "next-intl": "^4.14.9",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@types/bcryptjs": "^2.4.6",
    "@types/leaflet": "^1.9.22",
    "@types/node": "^22.18.6",
    "@types/react": "^19.1.16",
    "@types/react-dom": "^19.1.9",
    "autoprefixer": "^10.4.21",
    "postcss": "^8.5.32",
    "prisma": "6.19.3",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2",
    "vitest": "5.0.5"
  },
  "overrides": {
    "postcss": "$postcss",
    "sharp": "0.35.5",
    "@swc/helpers": "0.5.23",
    "deepmerge-ts": "8.0.2"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  }
}
