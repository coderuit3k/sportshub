{
  "name": "sportshub",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": "26.x",
    "npm": "12.x"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "node --env-file-if-exists=.env node_modules/vitest/vitest.mjs run",
    "db:seed": "node --env-file-if-exists=.env --import tsx prisma/seed.ts",
    "db:push": "prisma db push",
    "db:generate": "prisma generate",
    "db:postgis": "tsx scripts/setup-postgis.ts",
    "venues:near": "tsx scripts/venues-within-radius.ts",
    "test:e2e": "node --env-file-if-exists=.env --import tsx scripts/run-e2e.ts"
  },
  "dependencies": {
    "@aws-sdk/client-bedrock-runtime": "3.1161.0",
    "@aws-sdk/client-s3": "3.1161.0",
    "@aws-sdk/s3-request-presigner": "3.1161.0",
    "@prisma/client": "7.10.1",
    "@upstash/redis": "1.40.0",
    "bcryptjs": "3.0.3",
    "jose": "6.2.14",
    "leaflet": "1.9.4",
    "lucide-react": "1.66.0",
    "next": "16.4.3",
    "next-intl": "4.14.9",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "zod": "4.6.7",
    "@prisma/adapter-pg": "7.10.1",
    "pg-connection-string": "2.14.1",
    "@fontsource-variable/inter": "5.3.0",
    "@fontsource-variable/plus-jakarta-sans": "5.3.0"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@types/leaflet": "1.9.22",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "autoprefixer": "^10.4.21",
    "postcss": "^8.5.32",
    "prisma": "7.10.1",
    "tailwindcss": "^3.4.17",
    "tsx": "4.23.15",
    "typescript": "npm:@typescript/typescript6@6.0.2",
    "vitest": "5.0.5",
    "@typescript/native": "npm:typescript@7.0.2"
  },
  "overrides": {
    "postcss": "$postcss",
    "sharp": "0.35.5",
    "@swc/helpers": "0.5.23",
    "deepmerge-ts": "8.0.2"
  },
  "packageManager": "npm@12.2.1",
  "allowScripts": {
    "@parcel/watcher@2.6.0": true,
    "@prisma/engines@7.10.1": true,
    "esbuild@0.28.2": true,
    "@swc/core@1.16.20": true,
    "prisma@7.10.1": true
  }
}
