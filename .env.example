DATABASE_URL="file:./dev.db"
AUTH_SECRET="change-me-in-production-at-least-32-chars"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
# Production PostgreSQL example:
# DATABASE_URL="postgresql://user:password@host:5432/sportshub?schema=public"

# Rate limiting (optional): set BOTH to switch the shared limiters from the
# per-instance in-memory fallback to global Upstash Redis counters.
# On Vercel these are injected automatically by the Marketplace
# Upstash/Redis (Vercel KV) integration.
# KV_REST_API_URL=
# KV_REST_API_TOKEN=

# Venue photo storage (optional, Cloudflare R2): set ALL FIVE to enable.
# While any is missing, the build's photo migration skips with a log line
# and owner photo uploads show a disabled "not configured" state —
# everything else works exactly as before (photos display from the code
# map). Setup checklist: docs/architecture.md → "Image storage".
# NEVER commit real values; in production these live only in the Vercel
# project's Environment Variables.
# R2_ACCOUNT_ID=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_BUCKET=
# R2_PUBLIC_BASE_URL=
