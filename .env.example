DATABASE_URL="file:./dev.db"
AUTH_SECRET="change-me-in-production-at-least-32-chars"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
# Production PostgreSQL example:
# DATABASE_URL="postgresql://user:password@host:5432/sportshub?schema=public"

# Rate limiting (optional): set BOTH to switch the shared limiters from the
# per-instance in-memory fallback to global Upstash Redis counters.
# On Vercel these are injected automatically by the Marketplace
# Upstash/Redis (Vercel KV) integration.
# KV_REST_API_URL=
# KV_REST_API_TOKEN=

# Venue photo storage (optional, Cloudflare R2): set ALL FIVE to enable.
# While any is missing, the build's photo migration skips with a log line
# and owner photo uploads show a disabled "not configured" state —
# everything else works exactly as before (photos display from the code
# map). Setup checklist: docs/architecture.md → "Image storage".
# NEVER commit real values; in production these live only in the Vercel
# project's Environment Variables.
# R2_ACCOUNT_ID=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_BUCKET=
# R2_PUBLIC_BASE_URL=

# AI assistant (optional). Default provider: Amazon Bedrock running
# Claude Haiku 4.5 — authenticated by the standard AWS credential
# chain, so there is NO provider API key. Without AWS credentials the
# /assistant page still renders, but the first turn returns a clear
# typed config error — there is no fake fallback model.
#   AI_PROVIDER=bedrock
#   AI_MODEL=anthropic.claude-haiku-4-5-20251001-v1:0
#     NOTE: bedrock-runtime cannot invoke this model by its bare ID
#     on demand; the adapter resolves it to the geo inference profile
#     for AWS_REGION automatically (us-east-1 → us.anthropic.…), which
#     is the same model. A full profile ID or ARN in AI_MODEL is used
#     as-is.
#   AWS_REGION=us-east-1
#   AWS_ACCESS_KEY_ID=
#   AWS_SECRET_ACCESS_KEY=
# Alternative provider (any OpenAI-compatible endpoint):
#   AI_PROVIDER=openai-compatible
#   AI_API_KEY=
#   AI_BASE_URL=https://api.openai.com/v1
#   AI_MODEL=gpt-4o-mini
# AI_ASSISTANT_ENABLED=true
# AI_MAX_TOOL_EXECUTIONS=10
# AI_MAX_EVIDENCE_ROUNDS=1
# AI_PRICE_INPUT_PER_MILLION=
# AI_PRICE_OUTPUT_PER_MILLION=
