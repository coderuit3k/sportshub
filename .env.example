# Rate limiting (optional): set BOTH to switch the shared limiters from the
# per-instance in-memory fallback to global Upstash Redis counters.
# On Vercel these are injected automatically by the Marketplace
# Upstash/Redis (Vercel KV) integration.
# KV_REST_API_URL=
# KV_REST_API_TOKEN=
